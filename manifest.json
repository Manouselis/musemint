{
  "manifest_version": 3,
  "name": "MuseMint — Playlist Discovery",
  "version": "0.9.2",
  "description": "Taste-graph recommendations and one-click playlist adds for YouTube Music.",
  "minimum_chrome_version": "120",
  "host_permissions": ["https://music.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "css": ["content.css"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Open MuseMint on a YouTube Music playlist"
  },
  "background": { "service_worker": "service-worker.js" }
}
